CREATE TABLE Goal (
    id             TEXT    NOT NULL PRIMARY KEY,
    name           TEXT    NOT NULL,
    icon           TEXT    NOT NULL DEFAULT 'target',
    target_amount  REAL    NOT NULL,
    saved_amount   REAL    NOT NULL DEFAULT 0.0,
    deadline       INTEGER,
    is_completed   INTEGER NOT NULL DEFAULT 0,
    created_at     INTEGER NOT NULL
);

selectAll:
SELECT * FROM Goal ORDER BY is_completed ASC, CASE WHEN deadline IS NULL THEN 1 ELSE 0 END ASC, deadline ASC;

selectActive:
SELECT * FROM Goal WHERE is_completed = 0 ORDER BY CASE WHEN deadline IS NULL THEN 1 ELSE 0 END ASC, deadline ASC;

progressPercent:
SELECT id,
    CASE WHEN target_amount > 0
        THEN MIN((saved_amount / target_amount) * 100, 100.0)
        ELSE 0.0
    END AS percent
FROM Goal WHERE id = ?;

insert:
INSERT INTO Goal VALUES (?, ?, ?, ?, ?, ?, ?, ?);

addToSaved:
UPDATE Goal
SET saved_amount = MIN(saved_amount + :amount, target_amount),
    is_completed = CASE WHEN saved_amount + :amount >= target_amount THEN 1 ELSE 0 END
WHERE id = :id;

delete:
DELETE FROM Goal WHERE id = ?;

deleteAll:
DELETE FROM Goal;