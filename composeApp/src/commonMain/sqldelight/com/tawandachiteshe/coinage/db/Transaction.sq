CREATE TABLE `Transaction` (
    id            TEXT    NOT NULL PRIMARY KEY,
    amount        REAL    NOT NULL,
    type          TEXT    NOT NULL,
    category_id   TEXT    NOT NULL REFERENCES Category(id),
    merchant      TEXT    NOT NULL,
    notes         TEXT,
    currency_code TEXT    NOT NULL DEFAULT 'USD',
    date          INTEGER NOT NULL,
    created_at    INTEGER NOT NULL,
    goal_id       TEXT               -- nullable; set when transaction is a goal contribution
);

CREATE INDEX idx_tx_date     ON `Transaction`(date DESC);
CREATE INDEX idx_tx_category ON `Transaction`(category_id);
CREATE INDEX idx_tx_type     ON `Transaction`(type);

selectAll:
SELECT t.*, c.name AS category_name, c.icon AS category_icon, c.color_hex AS category_color
FROM `Transaction` t
JOIN Category c ON t.category_id = c.id
ORDER BY t.date DESC;

selectByDateRange:
SELECT t.*, c.name AS category_name, c.icon AS category_icon, c.color_hex AS category_color
FROM `Transaction` t
JOIN Category c ON t.category_id = c.id
WHERE t.date >= :startMs AND t.date < :endMs
ORDER BY t.date DESC;

selectByType:
SELECT t.*, c.name AS category_name, c.icon AS category_icon, c.color_hex AS category_color
FROM `Transaction` t
JOIN Category c ON t.category_id = c.id
WHERE t.type = :type
ORDER BY t.date DESC;

-- Helper: converts a raw amount to the user's base currency.
-- Formula: amount × (base.rate_to_usd / tx_currency.rate_to_usd)
-- COALESCE(cur.rate_to_usd, 1.0) guards against unknown currency codes.

totalByTypeAndDateRange:
SELECT COALESCE(SUM(
    t.amount
    * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1)
    / COALESCE(cur.rate_to_usd, 1.0)
), 0.0) AS total
FROM `Transaction` t
LEFT JOIN Currency cur ON t.currency_code = cur.code
WHERE t.type = :type AND t.date >= :startMs AND t.date < :endMs;

-- Single reactive query: returns both income and expense totals in base currency.
totalsByDateRange:
SELECT
    COALESCE(SUM(CASE WHEN t.type = 'INCOME'
        THEN t.amount * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1) / COALESCE(cur.rate_to_usd, 1.0)
        ELSE 0.0 END), 0.0) AS income_total,
    COALESCE(SUM(CASE WHEN t.type = 'EXPENSE'
        THEN t.amount * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1) / COALESCE(cur.rate_to_usd, 1.0)
        ELSE 0.0 END), 0.0) AS expense_total
FROM `Transaction` t
LEFT JOIN Currency cur ON t.currency_code = cur.code
WHERE t.date >= :startMs AND t.date < :endMs;

totalByCategoryAndDateRange:
SELECT t.category_id, COALESCE(SUM(
    t.amount
    * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1)
    / COALESCE(cur.rate_to_usd, 1.0)
), 0.0) AS total
FROM `Transaction` t
LEFT JOIN Currency cur ON t.currency_code = cur.code
WHERE t.date >= :startMs AND t.date < :endMs AND t.type = 'EXPENSE'
GROUP BY t.category_id
ORDER BY total DESC;

biggestExpenseInRange:
SELECT t.merchant,
    t.amount * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1) / COALESCE(cur.rate_to_usd, 1.0) AS amount
FROM `Transaction` t
LEFT JOIN Currency cur ON t.currency_code = cur.code
WHERE t.type = 'EXPENSE' AND t.date >= :startMs AND t.date < :endMs
ORDER BY amount DESC
LIMIT 1;

topMerchantInRange:
SELECT t.merchant,
    COUNT(*) AS visit_count,
    COALESCE(SUM(
        t.amount * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1) / COALESCE(cur.rate_to_usd, 1.0)
    ), 0.0) AS total_amount
FROM `Transaction` t
LEFT JOIN Currency cur ON t.currency_code = cur.code
WHERE t.type = 'EXPENSE' AND t.date >= :startMs AND t.date < :endMs
GROUP BY t.merchant
ORDER BY visit_count DESC
LIMIT 1;

countInRange:
SELECT COUNT(*) AS tx_count FROM `Transaction`
WHERE date >= :startMs AND date < :endMs;

-- Reactive: all-time net balance in base currency, used for goal contribution validation.
allTimeTotals:
SELECT
    COALESCE(SUM(CASE WHEN t.type = 'INCOME'
        THEN t.amount * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1) / COALESCE(cur.rate_to_usd, 1.0)
        ELSE 0.0 END), 0.0) AS income_total,
    COALESCE(SUM(CASE WHEN t.type = 'EXPENSE'
        THEN t.amount * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1) / COALESCE(cur.rate_to_usd, 1.0)
        ELSE 0.0 END), 0.0) AS expense_total
FROM `Transaction` t
LEFT JOIN Currency cur ON t.currency_code = cur.code;

-- Reactive: total saved per goal in base currency.
savingsPerGoal:
SELECT t.goal_id, COALESCE(SUM(
    t.amount * (SELECT c2.rate_to_usd FROM Currency c2 JOIN UserPrefs p ON c2.code = p.base_currency_code LIMIT 1) / COALESCE(cur.rate_to_usd, 1.0)
), 0.0) AS total
FROM `Transaction` t
LEFT JOIN Currency cur ON t.currency_code = cur.code
WHERE t.goal_id IS NOT NULL AND t.type = 'EXPENSE'
GROUP BY t.goal_id;

insert:
INSERT INTO `Transaction` (id, amount, type, category_id, merchant, notes, currency_code, date, created_at, goal_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

delete:
DELETE FROM `Transaction` WHERE id = ?;

deleteAll:
DELETE FROM `Transaction`;